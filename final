# 19. SENSITIVITY TO LOSS FUNCTION (MSE vs MAE)
# ─────────────────────────────────────────────────────────────────────────────
print("\n" + "="*60)
print("STEP 12 – LOSS FUNCTION SENSITIVITY  (MSE vs MAE)")
print("="*60)

loss_rows = []
for loss_name, loss_fn in [('MSE', nn.MSELoss()), ('MAE', nn.L1Loss())]:
    m = BiLSTMModel(n_features, HIDDEN_SIZE, N_LAYERS, n_features, DROPOUT).to(DEVICE)
    opt = torch.optim.Adam(m.parameters(), lr=LR, weight_decay=1e-5)
    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(opt, patience=3, factor=0.5)
    best_v, best_wts, no_imp = np.inf, copy.deepcopy(m.state_dict()), 0
    for ep in range(20):
        m.train()
        for xb, yb in train_loader:
            opt.zero_grad()
            loss = loss_fn(m(xb), yb)
            loss.backward()
            nn.utils.clip_grad_norm_(m.parameters(), 1.0)
            opt.step()
        m.eval()
        with torch.no_grad():
            vl = loss_fn(m(X_test), y_test).item()
        scheduler.step(vl)
        if vl < best_v:
            best_v = vl; best_wts = copy.deepcopy(m.state_dict()); no_imp = 0
        else:
            no_imp += 1
        if no_imp >= 5:
            break
    m.load_state_dict(best_wts)
    _, _, sens_metrics = evaluate_model(m, X_test, y_test, scaler)
    loss_rows.append(dict(Loss=loss_name, **{k: round(v,4)
                                             for k,v in sens_metrics.items()}))
    print(f"  [BiLSTM – {loss_name}]  "
          f"MAE={sens_metrics['MAE']:.4f}  "
          f"RMSE={sens_metrics['RMSE']:.4f}  "
          f"R²={sens_metrics['R2']:.4f}")

