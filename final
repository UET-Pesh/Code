def permutation_importance(model, X_np, y_true_inv, scaler):
    """Compute RMSE increase when each feature is shuffled (batched)."""
    model.eval()
    X_t = torch.tensor(X_np).to(DEVICE)
    with torch.no_grad():
        base_preds = scaler.inverse_transform(
            model(X_t).cpu().numpy())
    base_rmse = np.sqrt(mean_squared_error(y_true_inv, base_preds))

    importances = []
    rng = np.random.default_rng(0)
    for fi in range(X_np.shape[2]):
        X_shuf = X_np.copy()
        rng.shuffle(X_shuf[:, :, fi])
        with torch.no_grad():
            shuf_preds = scaler.inverse_transform(
                model(torch.tensor(X_shuf).to(DEVICE)).cpu().numpy())
        shuf_rmse = np.sqrt(mean_squared_error(y_true_inv, shuf_preds))
        importances.append(shuf_rmse - base_rmse)
    return np.array(importances)

