# STATISTICAL SIGNIFICANCE TESTING: Bi-LSTM vs Bi-GRU
# ─────────────────────────────────────────────────────────────────────
from scipy.stats import wilcoxon, t as t_dist

def diebold_mariano(e1, e2, h=1, power=2):
    """
    Diebold-Mariano test of equal predictive accuracy (Harvey-Leybourne-
    Newbold small-sample correction). e1, e2 = aligned forecast errors
    (true - pred) for model 1 and model 2. power=2 -> squared-error loss.
    DM>0 => model 1 has the LARGER loss (i.e. model 2 is better).
    """
    e1, e2 = np.asarray(e1, float), np.asarray(e2, float)
    d = np.abs(e1)**power - np.abs(e2)**power      # loss differential
    T = len(d); d_bar = d.mean()
    gamma0 = np.mean((d - d_bar)**2)
    gammas = [np.mean((d[k:] - d_bar)*(d[:-k] - d_bar)) for k in range(1, h)]
    var_d = (gamma0 + 2*sum(gammas)) / T
    DM = d_bar / np.sqrt(var_d)
    corr = np.sqrt((T + 1 - 2*h + h*(h-1)/T) / T)
    DM_star = DM * corr
    p = 2 * (1 - t_dist.cdf(abs(DM_star), df=T-1))
    return DM_star, p

print("\n" + "="*60)
print("STATISTICAL SIGNIFICANCE: Bi-LSTM vs Bi-GRU")
print("="*60)

# Per-feature Diebold-Mariano (squared-error loss, one-step)
dm_rows = []
for i, col in enumerate(FEATURE_COLS):
    e_lstm = trues[:, i]     - preds_lstm[:, i]
    e_gru  = trues_gru[:, i] - preds_gru[:, i]
    dm, p = diebold_mariano(e_lstm, e_gru, h=1, power=2)
    favors = "Bi-GRU" if dm > 0 else "Bi-LSTM"
    dm_rows.append(dict(Feature=col, DM=round(dm, 3),
                        p_value=p, Favors=favors))
    print(f"  {col:35s} DM={dm:+.3f}  p={p:.3e}  favors {favors}")
