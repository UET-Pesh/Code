# 7. BOOTSTRAP CONFIDENCE INTERVALS
# ─────────────────────────────────────────────────────────────────────────────
def bootstrap_ci(y_true, y_pred, n_iter=BOOTSTRAP_N, seed=42):
    """Return 95% bootstrap CI dicts for MAE and RMSE."""
    rng = np.random.default_rng(seed)
    n = len(y_true)
    mae_boot, rmse_boot = np.zeros(n_iter), np.zeros(n_iter)
    for i in range(n_iter):
        idx = rng.integers(0, n, n)
        mae_boot[i]  = mean_absolute_error(y_true[idx], y_pred[idx])
        rmse_boot[i] = np.sqrt(mean_squared_error(y_true[idx], y_pred[idx]))
    return (np.percentile(mae_boot, [2.5, 97.5]),
            np.percentile(rmse_boot, [2.5, 97.5]))


# ─────────────────────────────────────────────────────────────────────────────
# 8. RECURSIVE MULTI-STEP FORECASTING
# ─────────────────────────────────────────────────────────────────────────────
def recursive_forecast(model, seed_seq, steps):
    """
    Autoregressive recursive forecasting.
    seed_seq: (N_INPUT, n_features) numpy array (SCALED)
    Returns: (steps, n_features) numpy array (SCALED)
    """
    model.eval()
    seq = seed_seq.copy()
    preds = []
    with torch.no_grad():
        for _ in range(steps):
            inp = torch.tensor(seq[np.newaxis], dtype=torch.float32).to(DEVICE)
            out = model(inp).cpu().numpy().flatten()
            preds.append(out)
            seq = np.vstack([seq[1:], out])
    return np.array(preds, dtype=np.float32)


# ─────────────────────────────────────────────────────────────────────────────
# 9. MONTE CARLO DROPOUT
# ─────────────────────────────────────────────────────────────────────────────
def mc_dropout_predict(model, X_tensor, n_samples=MC_SAMPLES):
    """Activate dropout at inference; return mean & std over passes."""
    model.eval()
    for m in model.modules():
        if isinstance(m, nn.Dropout):
            m.train()
    preds = []
    loader = DataLoader(TensorDataset(X_tensor), batch_size=256, shuffle=False)
    with torch.no_grad():
        for _ in range(n_samples):
            batch_preds = []
            for (xb,) in loader:
                batch_preds.append(model(xb).cpu().numpy())
            preds.append(np.concatenate(batch_preds))
    preds = np.array(preds)           # (n_samples, T, n_feat)
    return preds.mean(0), preds.std(0)


