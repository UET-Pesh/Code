# 6. TRAINING UTILITIES
# ─────────────────────────────────────────────────────────────────────────────
def train_model(model, loader, val_X, val_y, label='Model',
                epochs=N_EPOCHS, patience=PATIENCE, lr=LR):
    """
    Train with Adam + ReduceLROnPlateau + early stopping.
    Returns (trained_model, epoch_losses_list).
    """
    criterion = nn.MSELoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=lr, weight_decay=1e-5)
    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode='min', factor=0.5, patience=3, min_lr=1e-6)

    best_val  = float('inf')
    best_wts  = copy.deepcopy(model.state_dict())
    no_improve = 0
    epoch_losses = []
    t0 = time.time()

    for epoch in range(1, epochs + 1):
        model.train()
        total_loss = 0.0
        for xb, yb in loader:
            optimizer.zero_grad()
            pred = model(xb)
            loss = criterion(pred, yb)
            loss.backward()
            nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            optimizer.step()
            total_loss += loss.item()

        avg_loss = total_loss / len(loader)
        epoch_losses.append(avg_loss)

        # Validation loss for scheduler / early stop
        model.eval()
        with torch.no_grad():
            val_pred = model(val_X)
            val_loss = criterion(val_pred, val_y).item()

        scheduler.step(val_loss)

        if val_loss < best_val:
            best_val = val_loss
            best_wts = copy.deepcopy(model.state_dict())
            no_improve = 0
        else:
            no_improve += 1

        if epoch % 5 == 0:
            print(f"  [{label}] Epoch {epoch:3d}/{epochs}  "
                  f"train_loss={avg_loss:.5f}  val_loss={val_loss:.5f}  "
                  f"lr={optimizer.param_groups[0]['lr']:.2e}")

        if no_improve >= patience:
            print(f"  [{label}] Early stop at epoch {epoch} "
                  f"(best val_loss={best_val:.5f})")
            break

    model.load_state_dict(best_wts)
    elapsed = time.time() - t0
    print(f"  [{label}] Training done in {elapsed:.1f}s  "
          f"({elapsed/len(epoch_losses):.1f}s/epoch)")
    return model, epoch_losses


def evaluate_model(model, X_t, y_t, scaler, label=''):
    """Run inference, inverse-transform, compute metrics."""
    model.eval()
    preds_list, trues_list = [], []
    loader = DataLoader(TensorDataset(X_t, y_t), batch_size=256, shuffle=False)
    with torch.no_grad():
        for xb, yb in loader:
            preds_list.append(model(xb).cpu().numpy())
            trues_list.append(yb.cpu().numpy())
    preds = np.concatenate(preds_list)
    trues = np.concatenate(trues_list)
    preds_inv = scaler.inverse_transform(preds)
    trues_inv  = scaler.inverse_transform(trues)
    mae  = mean_absolute_error(trues_inv, preds_inv)
    mse  = mean_squared_error(trues_inv, preds_inv)
    rmse = np.sqrt(mse)
    r2   = r2_score(trues_inv, preds_inv)
    rel_err = np.abs(trues_inv - preds_inv) / (np.abs(trues_inv) + 1e-8)
    acc  = np.mean(rel_err <= TOLERANCE_PCT)
    if label:
        print(f"\n  [{label}] MAE={mae:.4f}  RMSE={rmse:.4f}  "
              f"R²={r2:.4f}  Acc(±{int(TOLERANCE_PCT*100)}%)={acc:.4f}")
    return preds_inv, trues_inv, dict(MAE=mae, MSE=mse, RMSE=rmse, R2=r2, Acc=acc)


def measure_inference_time(model, loader, label=''):
    """Measure total and per-sample inference latency."""
    model.eval()
    n = 0
    t0 = time.time()
    with torch.no_grad():
        for xb, _ in loader:
            model(xb)
            n += len(xb)
    total = time.time() - t0
    per_sample = total / n
    print(f"  [{label}] Inference: {total*1000:.1f} ms total  "
          f"| {per_sample*1000:.3f} ms/sample")
    return total, per_sample


