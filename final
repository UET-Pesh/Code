def create_sequences(data, n_input):
    X, y = [], []
    for i in range(len(data) - n_input):
        X.append(data[i : i + n_input])
        y.append(data[i + n_input])
    return np.array(X, dtype=np.float32), np.array(y, dtype=np.float32)

